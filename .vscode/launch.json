{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GUI Mode (--gui)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tenebris-lux",
            "args": [
                "--gui"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Engine (Debug)"
        },
        {
            "name": "Debug CLI Mode (--cli)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tenebris-lux",
            "args": [
                "--cli"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Engine (Debug)"
        },
        {
            "name": "Debug Interactive State Debugger (--debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tenebris-lux",
            "args": [
                "--debug"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Engine (Debug)"
        },
        {
            "name": "Debug Pre-Flight Audit (--audit)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tenebris-lux",
            "args": [
                "--audit"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Engine (Debug)"
        },
        {
            "name": "Debug Safe-Mode BIOS ROM Fallback",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tenebris-lux",
            "args": [
                "-r",
                "/tmp/nonexistent_fallback_root",
                "--audit"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Engine (Debug)"
        },
        {
            "name": "Debug Rust Tool: tl_tools",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/tools/target/debug/tl_tools",
            "args": [
                "validate",
                "all"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
