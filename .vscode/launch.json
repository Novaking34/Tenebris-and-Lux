{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GUI Mode",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tenebris-lux",
            "args": [
                "--gui"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Engine (Debug)"
        },
