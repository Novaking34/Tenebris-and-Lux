    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Comprehensive linguistic dictionary: Dialogue, Quest states, Puzzle interaction verbs, and Statera lexicon.",
    "where_the_data_lives": {
      "topology": "System Runtime String Buffers",
      "path": "engine/config/runtime/string/lexicon.json"
    },
    "what_it_enables": [
      "Dialogue engine formatting: speaker identifiers, emotion qualifiers, and text crawl pauses",
      "Quest tracking state machine tokens and journal category headers",
      "Environmental puzzle and dungeon interaction verbs (push, rotate, place_relic, tune_compass)",
      "Authentic continental stance lexicon featuring the canonical Statera fourth posture"
    ],
    "invariants": [
      "Zero dynamic heap allocation during lexical lookup (ALLOC_ZERO_HEAP)",
      "All tokens must be non-empty null-terminated strings",
      "Speaker tags must resolve to valid roster entities or world actors",
      "Dialogue crawl timing must evaluate to positive millisecond durations"
    ]
  },
