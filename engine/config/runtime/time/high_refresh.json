{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/runtime/time/high_refresh.json",
    "id": "engine.config.runtime.time.high_refresh",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "High refresh rate 120 FPS timing profile for low-latency simulation display.",
    "where_the_data_lives": {
      "topology": "System Runtime Timing",
      "path": "engine/config/runtime/time/high_refresh.json"
    },
    "what_it_enables": [
      "Ultra low latency 120 Hz frame pacing with 8.33ms frame budget",
      "Sub-25 us simulation turn latency budget for high-speed action battles",
      "Halved pre-flight latency budget (500 us) and disk query budget (250 us)"
    ],
    "invariants": [
      "Zero dynamic heap allocations during time profile loading (ALLOC_ZERO_HEAP)",
      "Target FPS must be strictly positive (target_fps > 0)",
      "Frame budget in ms must equal 1000.0 / target_fps within sub-microsecond precision",
      "Monotonic timing source strictly anchored to POSIX.1b CLOCK_MONOTONIC"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "time_utils": "core/time_utils.h",
      "clock_source": "CLOCK_MONOTONIC"
    },
    "static_declarations": {
      "schema_id": "tenlux.data.time_profile.v1",
      "target_struct": "time_config_t",
      "header_binding": "include/core/time_utils.h"
    },
    "generic_helper_contracts": {
      "loader": "time_load_config_from_file",
      "now": "time_monotonic_now_ns",
      "sleep_ms": "time_sleep_ms"
    }
  },
  "block_3_body": {
    "profile": {
      "id": "high_refresh",
      "display_name": "High-Refresh 120 FPS Gaming Profile",
      "description": "Ultra low latency 120 Hz frame pacing with 25 us simulation turn latency budget.",
      "target_fps": 120,
      "frame_budget_ms": 8.333333,
      "turn_latency_budget_us": 25.0,
      "preflight_latency_budget_us": 500.0,
      "disk_query_budget_us": 250.0,
      "token_extraction_budget_us": 25.0,
      "tick_rate_hz": 120
    }
  },
  "block_4_audit": {
    "tripwires": [
      {
        "id": "TRIPWIRE_FPS_BOUNDS",
        "condition": "target_fps == 120",
        "action": "Fatal halt if high refresh target FPS deviates from 120 Hz"
      },
      {
        "id": "TRIPWIRE_FRAME_BUDGET",
        "condition": "frame_budget_ms > 8.0 && frame_budget_ms < 9.0",
        "action": "Fatal halt if frame budget is mathematically inconsistent"
      }
    ],
    "metrics": {
      "expected_ms_per_frame": 8.333333,
      "max_simulation_turn_cost_pct": 0.3,
      "monotonic_clock_source": "CLOCK_MONOTONIC",
      "zero_heap_compliant": true
    }
  },
  "block_5_closing": {
    "navigation": {
      "parent_menu": "manifest.json",
      "subdomain_manifest": "../manifest.json",
      "root_manifest": "../../../manifest.json",
      "menu_index": 2
    },
    "execution_hooks": {
      "on_load": "time_load_config_from_file",
      "audit_hook": "time_utils_preflight"
    }
  }
}
