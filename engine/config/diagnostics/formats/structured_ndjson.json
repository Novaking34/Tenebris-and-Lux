{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/diagnostics/formats/structured_ndjson.json",
    "id": "engine.config.diagnostics.formats.structured_ndjson",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Specification of the Newline-Delimited JSON (NDJSON) streaming log schema for telemetry pipelines and analytics.",
    "where_the_data_lives": {
      "path": "engine/config/diagnostics/formats/structured_ndjson.json",
      "header_binding": "engine/include/log/log.h"
    },
    "what_it_enables": [
      "Machine-parsable JSON line-by-line stream for automated ELT and analysis pipelines",
      "Structured key-value serialization of source file anchors, error codes, and grades",
      "Direct conversion from runtime log text into persistent data catalog tables"
    ],
    "invariants": [
      "Each line must be a self-contained, strictly valid JSON object",
      "No newlines allowed within string values (escaped as \\n)",
      "Universal 5-Block Lifecycle Protocol enforced across all definitions"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "log_subsystem_initialized": true,
      "format_schema_registered": true
    },
    "static_declarations": {
      "schema_id": "tenlux.format.structured_ndjson.v1",
      "mime_type": "application/x-ndjson",
      "format_type": "STRUCTURED_STREAMING_JSON"
    },
    "generic_helper_contracts": {
      "serializer": "log_serialize_entry_to_json",
      "deserializer": "log_deserialize_json_to_entry"
    }
  },
  "block_3_body": {
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TenebrisLuxTelemetryRecord",
      "type": "object",
      "required": [
        "seq",
        "ts",
        "sev",
        "dom",
        "chan",
        "msg"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "description": "Monotonic incrementing sequence ID"
        },
        "mono_us": {
          "type": "integer",
          "description": "Monotonic delta in microseconds"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "UTC ISO 8601 timestamp"
        },
        "sev": {
          "type": "string",
          "enum": [
            "FATAL",
            "CRITICAL",
            "ERROR",
            "WARNING",
            "INFO",
            "DEBUG",
            "TRACE"
          ]
        },
        "sev_w": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100,
          "description": "Numeric severity weight"
        },
        "dom": {
          "type": "string",
          "enum": [
            "ENGINE",
            "GAME"
          ],
          "description": "Top-level error domain"
        },
        "chan": {
          "type": "string",
          "description": "Telemetry channel identifier (e.g. ENG_CORE, GAME_STATERA)"
        },
        "ent": {
          "type": "string",
          "maxLength": 16,
          "description": "Entity or subsystem name"
        },
        "grd": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Moral grade or audit score [-100, +100]"
        },
        "err_code": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{4}$",
          "description": "Hexadecimal error code"
        },
        "mnemonic": {
          "type": "string",
          "description": "Mnemonic error string (e.g. ERR_GAME_COMBAT_STANCE_ILLEGAL)"
        },
        "src": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "func": {
              "type": "string"
            }
          }
        },
        "msg": {
          "type": "string",
          "maxLength": 256,
          "description": "Log message payload"
        },
        "breadcrumbs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Trail of preceding contextual decisions or states"
        }
      },
      "example_record": {
        "seq": 42,
        "mono_us": 128450,
        "ts": "2026-11-05T18:30:00.123456Z",
        "sev": "INFO",
        "sev_w": 20,
        "dom": "GAME",
        "chan": "GAME_STATERA",
        "ent": "ConscienceLedg",
        "grd": 15,
        "msg": "Statera balance maintained: Moral sway +15",
        "src": {
          "file": "game/src/hero/sim_state.c",
          "line": 214,
          "func": "sim_update_statera"
        }
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "required_fields_count": 6,
      "optional_fields_count": 8,
      "schema_draft": "Draft-07"
    },
    "verification_tripwires": [
      {
        "name": "SCHEMA_VALID",
        "rule": "schema adheres to JSON Schema Draft-07",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "LINE_DELIMITED",
        "rule": "format emits exactly one JSON record per newline",
        "status": "VERIFIED_PASS"
      }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "output_sink": "build/logs/telemetry.ndjson"
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "sister_format": "tabular_csv.json"
    }
  }
}
