{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/diagnostics/formats/tabular_csv.json",
    "id": "engine.config.diagnostics.formats.tabular_csv",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Specification of the Tabular CSV telemetry export format for spreadsheet analysis and database imports.",
    "where_the_data_lives": {
      "path": "engine/config/diagnostics/formats/tabular_csv.json",
      "header_binding": "engine/include/log/log.h"
    },
    "what_it_enables": [
      "Standard RFC 4180 CSV export for direct loading into pandas, spreadsheets, and SQL engines",
      "Normalized tabular rows with dedicated columns for error mnemonics and hex codes",
      "Rapid statistical analysis of frame pacing, stance transitions, and combat damage"
    ],
    "invariants": [
      "RFC 4180 standard escaping rules strictly enforced (double quotes around commas)",
      "Header line must always be the first record in the exported CSV",
      "Universal 5-Block Lifecycle Protocol enforced across all definitions"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "log_subsystem_initialized": true,
      "format_schema_registered": true
    },
    "static_declarations": {
      "schema_id": "tenlux.format.tabular_csv.v1",
      "mime_type": "text/csv",
      "delimiter": ",",
      "quote_char": "\"",
      "escape_char": "\"",
      "line_terminator": "\r\n"
    },
    "generic_helper_contracts": {
      "csv_exporter": "log_export_ring_to_csv",
      "csv_escaper": "str_escape_csv_field"
    }
  },
  "block_3_body": {
    "csv_spec": {
      "header_row": "sequence_id,monotonic_us,timestamp,severity,weight,domain,channel,entity,grade,error_code,mnemonic,source_file,source_line,message",
      "columns": [
        {
          "name": "sequence_id",
          "type": "INTEGER",
          "description": "Monotonic entry sequence counter"
        },
        {
          "name": "monotonic_us",
          "type": "INTEGER",
          "description": "Microsecond timestamp from CLOCK_MONOTONIC"
        },
        {
          "name": "timestamp",
          "type": "STRING",
          "description": "ISO 8601 UTC timestamp string"
        },
        {
          "name": "severity",
          "type": "STRING",
          "description": "FATAL, CRITICAL, ERROR, WARNING, INFO, DEBUG, TRACE"
        },
        {
          "name": "weight",
          "type": "INTEGER",
          "description": "Severity priority weight [5, 100]"
        },
        {
          "name": "domain",
          "type": "STRING",
          "description": "ENGINE or GAME"
        },
        {
          "name": "channel",
          "type": "STRING",
          "description": "Telemetry channel name"
        },
        {
          "name": "entity",
          "type": "STRING",
          "description": "Target entity or character identifier"
        },
        {
          "name": "grade",
          "type": "INTEGER",
          "description": "Moral sway or audit grade [-100, +100]"
        },
        {
          "name": "error_code",
          "type": "STRING",
          "description": "Hexadecimal error code or empty string"
        },
        {
          "name": "mnemonic",
          "type": "STRING",
          "description": "Error mnemonic string or empty string"
        },
        {
          "name": "source_file",
          "type": "STRING",
          "description": "Originating source file path (__FILE__)"
        },
        {
          "name": "source_line",
          "type": "INTEGER",
          "description": "Originating source line number (__LINE__)"
        },
        {
          "name": "message",
          "type": "STRING",
          "description": "Payload message escaped with RFC 4180 quotes"
        }
      ],
      "escaping_rules": {
        "quote_on_comma": true,
        "quote_on_newline": true,
        "quote_on_quotes": true,
        "double_quote_escape": true
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "column_count": 14,
      "delimiter": "comma",
      "rfc_compliant": true
    },
    "verification_tripwires": [
      {
        "name": "COLUMN_COUNT_MATCH",
        "rule": "count(columns) == 14",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "HEADER_MATCH",
        "rule": "header row matches column sequence exactly",
        "status": "VERIFIED_PASS"
      }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "output_sink": "build/logs/telemetry.csv"
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "sister_format": "replay_event_stream.json"
    }
  }
}
