{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/diagnostics/telemetry/production.json",
    "id": "engine.config.diagnostics.telemetry.production",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Production release logging configuration profile optimized for clean player execution and minimal I/O overhead.",
    "where_the_data_lives": {
      "path": "engine/config/diagnostics/telemetry/production.json",
      "log_output_directory": "build/logs/",
      "header_binding": "engine/include/log/log.h"
    },
    "what_it_enables": [
      "Minimum severity set to INFO to prevent disk bloating on shipped systems",
      "Console echo disabled to maintain pure graphical or CLI presentation",
      "Rotated 5 MB log files capturing only significant state and narrative events"
    ],
    "invariants": [
      "Zero dynamic heap allocations in static ring buffer telemetry",
      "Console echo strictly disabled during production execution",
      "Universal 5-Block Lifecycle Protocol enforced across all definitions"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "log_subsystem_initialized": true,
      "static_ring_buffer_allocated": true,
      "production_flags_verified": true
    },
    "static_declarations": {
      "schema_id": "tenlux.data.log_setting.v1",
      "target_struct": "log_config_t",
      "header_binding": "engine/include/log/log.h",
      "supported_domains": [
        "ENGINE",
        "GAME"
      ]
    },
    "generic_helper_contracts": {
      "config_loader": "log_load_config_from_file",
      "profiler_binding": "log_load_config_profile"
    }
  },
  "block_3_body": {
    "setting": {
      "id": "production",
      "display_name": "Production / Shipping Release",
      "description": "Optimized release profile suppressing low-level debug spam, silencing terminal console echo, and enforcing clean 5 MB rotated archives.",
      "log_dir": "logs",
      "base_filename": "tenebris_lux.log",
      "max_file_size_bytes": 5242880,
      "max_rotated_files": 10,
      "min_severity": "INFO",
      "save_by_category": true,
      "echo_to_console": false,
      "use_colors": false,
      "telemetry": {
        "track_sequence_ids": true,
        "track_monotonic_us": false,
        "track_iso_timestamps": true,
        "track_moral_grades": true,
        "detailed_file_anchors": false,
        "detailed_func_anchors": false,
        "active_categories": [
          "SYSTEM",
          "LOG",
          "EVENT",
          "MESSAGE",
          "CHARACTER",
          "IO"
        ]
      },
      "severity_filter_mask": "0x7C",
      "min_severity_weight": 20,
      "domain_routing": {
        "engine_domain_enabled": true,
        "game_domain_enabled": true,
        "isolate_domain_files": false
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "rotation_threshold_kb": 5120,
      "retention_policy": "Retain 10 timestamped rotated archives",
      "static_ring_buffer_slots": 64,
      "disk_io_budget": "Minimal I/O overhead per gameplay turn"
    },
    "verification_tripwires": [
      {
        "name": "NO_CONSOLE_ECHO",
        "rule": "echo_to_console == false",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "SEVERITY_FLOOR",
        "rule": "min_severity >= INFO",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "ZERO_HEAP_PROD",
        "rule": "Zero dynamic allocations during write",
        "status": "VERIFIED_PASS"
      }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "cli_flags": [
        "--gui",
        "--cli"
      ]
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "menu_index": 3
    }
  }
}
