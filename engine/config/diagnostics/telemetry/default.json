{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/diagnostics/telemetry/default.json",
    "id": "engine.config.diagnostics.telemetry.default",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Default baseline log configuration profile mirroring Layer 0 log_get_default_config().",
    "where_the_data_lives": {
      "path": "engine/config/diagnostics/telemetry/default.json",
      "log_output_directory": "build/logs/",
      "header_binding": "engine/include/log/log.h"
    },
    "what_it_enables": [
      "Standard baseline telemetry matching Layer 0 log_get_default_config()",
      "Multi-domain channel routing across Engine and Game boundaries",
      "Fixed 1 MB log rotation threshold and ANSI terminal echoing"
    ],
    "invariants": [
      "Must accurately match all C11 engine default initialization parameters",
      "Memory footprint strictly adheres to ALLOC_ZERO_HEAP contracts",
      "Universal 5-Block Lifecycle Protocol enforced across all definitions"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "log_subsystem_initialized": true,
      "static_ring_buffer_allocated": true,
      "output_directory_writable": true
    },
    "static_declarations": {
      "schema_id": "tenlux.data.log_setting.v1",
      "target_struct": "log_config_t",
      "header_binding": "engine/include/log/log.h",
      "supported_domains": [
        "ENGINE",
        "GAME"
      ]
    },
    "generic_helper_contracts": {
      "config_loader": "log_load_config_from_file",
      "fallback_provider": "log_get_default_config"
    }
  },
  "block_3_body": {
    "setting": {
      "id": "default",
      "display_name": "Default Baseline Engine Configuration",
      "description": "Standard out-of-the-box configuration matching the Layer 0 log_get_default_config() baseline.",
      "log_dir": "logs",
      "base_filename": "tenebris_lux.log",
      "max_file_size_bytes": 1048576,
      "max_rotated_files": 25,
      "min_severity": "TRACE",
      "save_by_category": true,
      "echo_to_console": true,
      "use_colors": true,
      "telemetry": {
        "track_sequence_ids": true,
        "track_monotonic_us": true,
        "track_iso_timestamps": true,
        "track_moral_grades": true,
        "active_categories": [
          "SYSTEM",
          "LOG",
          "EVENT",
          "MESSAGE",
          "CHARACTER",
          "IO"
        ]
      },
      "severity_filter_mask": "0x7F",
      "min_severity_weight": 5,
      "domain_routing": {
        "engine_domain_enabled": true,
        "game_domain_enabled": true,
        "isolate_domain_files": true
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "rotation_threshold_kb": 1024,
      "retention_policy": "Retain 25 timestamped rotated archives",
      "static_ring_buffer_slots": 64,
      "latency_budget_us": 15
    },
    "verification_tripwires": [
      {
        "name": "ROTATION_CEILING",
        "rule": "max_file_size_bytes <= 10485760",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "ARCHIVE_LIMIT",
        "rule": "max_rotated_files <= 50",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "ZERO_HEAP_LOG",
        "rule": "Zero dynamic allocations during write",
        "status": "VERIFIED_PASS"
      }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "cli_flags": [
        "--audit",
        "--cli",
        "--gui"
      ]
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "menu_index": 1
    }
  }
}
