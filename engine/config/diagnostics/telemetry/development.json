{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/diagnostics/telemetry/development.json",
    "id": "engine.config.diagnostics.telemetry.development",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Development logging configuration profile for interactive engineering, live console echoing, and deep diagnostic trace.",
    "where_the_data_lives": {
      "path": "engine/config/diagnostics/telemetry/development.json",
      "log_output_directory": "build/logs/",
      "header_binding": "engine/include/log/log.h"
    },
    "what_it_enables": [
      "Full TRACE severity capturing microsecond tick timestamps",
      "Live ANSI colored console mirroring for developer observability",
      "Granular file, line, and function source anchor telemetry"
    ],
    "invariants": [
      "Zero dynamic heap allocations in static ring buffer telemetry",
      "Per-entry formatted write latency must not exceed 15 microseconds",
      "Universal 5-Block Lifecycle Protocol enforced across all definitions"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "log_subsystem_initialized": true,
      "static_ring_buffer_allocated": true,
      "terminal_ansi_support_detected": true
    },
    "static_declarations": {
      "schema_id": "tenlux.data.log_setting.v1",
      "target_struct": "log_config_t",
      "header_binding": "engine/include/log/log.h",
      "supported_domains": [
        "ENGINE",
        "GAME"
      ]
    },
    "generic_helper_contracts": {
      "config_loader": "log_load_config_from_file",
      "profiler_binding": "log_load_config_profile"
    }
  },
  "block_3_body": {
    "setting": {
      "id": "development",
      "display_name": "Development & Interactive Debugging",
      "description": "High-verbosity developer profile with real-time ANSI color console echoing, categorized file writes, and detailed turn traces.",
      "log_dir": "logs",
      "base_filename": "tenebris_lux_dev.log",
      "max_file_size_bytes": 2097152,
      "max_rotated_files": 25,
      "min_severity": "TRACE",
      "save_by_category": true,
      "echo_to_console": true,
      "use_colors": true,
      "telemetry": {
        "track_sequence_ids": true,
        "track_monotonic_us": true,
        "track_iso_timestamps": true,
        "track_moral_grades": true,
        "detailed_file_anchors": true,
        "detailed_func_anchors": true,
        "detailed_line_anchors": true,
        "active_categories": [
          "SYSTEM",
          "LOG",
          "EVENT",
          "MESSAGE",
          "CHARACTER",
          "IO"
        ]
      },
      "severity_filter_mask": "0x7F",
      "min_severity_weight": 5,
      "domain_routing": {
        "engine_domain_enabled": true,
        "game_domain_enabled": true,
        "isolate_domain_files": true
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "rotation_threshold_kb": 2048,
      "retention_policy": "Retain 25 timestamped rotated archives",
      "static_ring_buffer_slots": 64,
      "console_colors_enabled": true,
      "latency_budget_us": 15
    },
    "verification_tripwires": [
      {
        "name": "TRACE_ENABLED",
        "rule": "min_severity == TRACE",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "BUFFER_BOUNDED",
        "rule": "max_file_size_bytes <= 2097152",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "ZERO_HEAP_DEV",
        "rule": "Zero dynamic allocations during write",
        "status": "VERIFIED_PASS"
      }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "cli_flags": [
        "--debug",
        "--cli"
      ]
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "menu_index": 2
    }
  }
}
