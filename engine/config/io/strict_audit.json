    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Strict Forensic Audit, Atomic Write & Tight Schema Enforcement Profile",
    "invariants": [
      "Zero dynamic heap allocations (ALLOC_ZERO_HEAP)",
      "Small <= Medium <= Large <= Max Config Buffer Ladder",
      "Enforces atomic writes, traversal guards, and strict schema validation",
      "Halts into DEBUG_STEP_AWAIT when corrupt I/O policies trip active probes"
    ]
  },
  "block_2_opening": {
    "pre_conditions": [
      "Compiled into io_config_rom.h via CMake GenerateConfigRom",
      "Validates cleanly under io_fallback_validate_policy_contract()"
    ],
    "static_declarations": {
      "schema_id": "tenlux.engine.io_policy.v1",
      "target_stratum": "Layer 0: Core Utilities / I/O & VFS",
      "target_struct": "io_fallback_config_t"
    },
    "generic_helper_contracts": {
      "policy_parser": "io_fallback_parse_policy_json",
      "rom_loader": "io_fallback_load_rom_config",
      "fs_loader": "fs_utils_load_policy"
    },
    "capacities": {
      "max_config_bytes": 65536,
      "path_max_bytes": 512,
      "max_json_depth": 32
    }
  },
  "block_3_body": {
    "profile_name": "strict_audit",
    "default_root": "game/data",
    "small_bytes": 1024,
    "medium_bytes": 8192,
    "large_bytes": 32768,
    "max_config_bytes": 65536,
    "path_max_bytes": 512,
    "max_json_depth": 32,
    "max_json_tokens": 1024,
    "reject_on_truncation": true,
    "require_5block_envelope": true,
    "enforce_schema_id": true,
    "rom_fallback_enabled": true,
    "read_only_mode": false,
    "probe_await_on_corrupt_policy": true,
    "posix_dir_mode_octal": "0750",
    "flush_on_write": true,
    "atomic_write": true,
    "block_path_traversal": true,
    "max_symlink_depth": 2,
    "allow_mod_mounts": false,
    "strict_utf8_escapes": true,
    "reject_duplicate_keys": true,
    "hot_reload_enabled": false,
    "rom_fallback_asset": "rom://io/strict_audit.json"
  },
  "block_4_audit": {
    "audit_metrics": {
      "max_config_bytes": 65536,
      "path_max_bytes": 512,
      "zero_heap_compliant": true
    },
    "verification_tripwires": [
      {
        "name": "STRICT_ATOMIC_AUDIT",
        "rule": "atomic_write == true && flush_on_write == true && probe_await_on_corrupt_policy == true",
        "status": "VERIFIED_PASS"
      }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "unit_tests": [
        "unit_io_fallback_test",
        "unit_fs_utils_test"
      ],
      "cli_audit_command": "./build/tenebris-lux --audit"
    },
    "navigation": {
