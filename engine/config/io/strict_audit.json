{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/io/strict_audit.json",
    "id": "engine.config.io.strict_audit",
    "layer": "Layer 0: Core Engine / I/O Policy Profile",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
