{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/input/default.json",
    "id": "engine.config.input.default",
    "layer": "Layer 0: Core Utilities / Input Architecture",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Default Keyboard & Mouse Action Bindings and repeat policies.",
    "where_the_data_lives": {
      "topology": "Standalone Engine Input Configuration Sub-Domain",
      "path": "engine/config/input/default.json",
      "parent_manifest": "engine/config/input/manifest.json"
    },
    "what_it_enables": [
      "Directional grid navigation via Arrow Keys and WASD",
      "Action confirmation via Enter and Spacebar",
      "Cancellation and back navigation via Escape and Backspace",
      "Tactical stance switching between Lux (1/Q) and Tenebris (2/E)",
      "System hotkeys for Fullscreen toggle (F11/F) and Mute toggle (M)",
      "Zero dynamic heap allocations during action lookup (ALLOC_ZERO_HEAP)"
    ],
    "invariants": [
      "Zero dynamic heap allocations across input binding queries (ALLOC_ZERO_HEAP)",
      "Strict ISO C11 adherence (-std=c11, -Wall -Wextra -Wpedantic)",
      "Every action must have a valid non-empty primary key binding",
      "Key repeat delay must be greater than repeat rate"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "input_system": "gui.c / XLookupKeysym",
      "widgets_system": "gui_widgets.c"
    },
    "static_declarations": {
      "subdomain_id": "input",
      "schema_id": "tenlux.engine.input.bindings.v1",
      "target_stratum": "Layer 0 / Input Architecture",
      "total_actions": 12
    },
    "generic_helper_contracts": {
      "path_resolver": "path_finder_resolve",
      "master_loader": "master_loader_load"
    },
    "capacities": {
      "action_count": 12,
      "max_bindings_per_action": 3
    }
  },
  "block_3_body": {
    "behavior": {
      "repeat_delay_ms": 250,
      "repeat_rate_ms": 50,
      "mouse_drag_threshold_px": 4
    },
    "actions": [
