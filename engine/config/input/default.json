        "category": "navigation",
        "primary_key": "Up",
        "secondary_key": "w",
        "tertiary_key": "k"
      },
      {
        "id": "action_nav_down",
        "name": "Navigate Down / South",
        "category": "navigation",
        "primary_key": "Down",
        "secondary_key": "s",
        "tertiary_key": "j"
      },
      {
        "id": "action_nav_left",
        "name": "Navigate Left / West",
        "category": "navigation",
        "primary_key": "Left",
        "secondary_key": "a",
        "tertiary_key": "h"
      },
      {
        "id": "action_nav_right",
        "name": "Navigate Right / East",
        "category": "navigation",
        "primary_key": "Right",
        "secondary_key": "d",
        "tertiary_key": "l"
      },
      {
        "id": "action_confirm",
        "name": "Confirm / Select / Interact",
        "category": "interaction",
        "primary_key": "Return",
        "secondary_key": "space",
        "tertiary_key": "z"
      },
      {
        "id": "action_cancel",
        "name": "Cancel / Back / Close",
        "category": "interaction",
        "primary_key": "Escape",
        "secondary_key": "x",
        "tertiary_key": "BackSpace"
      },
      {
        "id": "action_menu",
        "name": "Toggle In-Game Menu / Options",
        "category": "system",
        "primary_key": "Tab",
        "secondary_key": "Escape",
        "tertiary_key": null
      },
      {
