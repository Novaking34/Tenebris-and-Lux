        "primary_key": "F11",
        "secondary_key": "f",
        "tertiary_key": null
      },
      {
        "id": "action_toggle_mute",
        "name": "Toggle Master Audio Mute",
        "category": "system",
        "primary_key": "m",
        "secondary_key": null,
        "tertiary_key": null
      }
    ]
  },
  "block_4_audit": {
    "audit_metrics": {
      "action_count": 12,
      "zero_heap_compliant": true
    },
    "verification_tripwires": [
      {
        "name": "PRIMARY_BINDINGS_PRESENT",
        "rule": "Every action has non-empty primary_key",
        "status": "VERIFIED_PASS"
      },
      {
        "name": "REPEAT_TIMING_INVARIANT",
        "rule": "repeat_delay_ms > repeat_rate_ms",
