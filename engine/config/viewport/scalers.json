{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/viewport/scalers.json",
    "id": "engine.config.viewport.scalers",
    "layer": "Layer 0: Core Utilities / Viewport Presentation",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "High-DPI font scaling coefficients and typography asset paths across viewport resolutions.",
    "where_the_data_lives": {
      "topology": "Standalone Engine Viewport Configuration Architecture",
      "path": "engine/config/viewport/scalers.json",
      "parent_manifest": "engine/config/manifest.json"
    },
    "what_it_enables": [
      "Letterbox/pillarbox font scaling preservation across resolutions",
      "Display presets ranging from retro 640x360 canvas up to 4K Ultra HD",
      "Proportional font point multipliers maintaining legibility and layout bounds",
      "Direct font asset path resolution with graceful procedural fallback",
      "Integer scaling alignment for pixel fonts and smooth TrueType rasterization"
    ],
    "invariants": [
      "Zero dynamic heap allocations in scaler computation (ALLOC_ZERO_HEAP)",
      "Base virtual canvas strictly fixed at 640x360 16:9 baseline",
      "Font scale multiplier must be strictly positive",
      "Asset paths are optional: missing files fall back to procedural glyph rasterizer",
      "AspectRatio strictly conserved: viewport letterboxes rather than stretching text"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "font_subsystem": "viewport/gui_fonts.h",
      "layout_geometry": "engine/config/viewport/scalers.json"
    },
    "static_declarations": {
      "schema_id": "tenlux.engine.viewport.scalers.v1",
      "target_struct": "gui_font_scaler_t",
      "header_binding": "include/viewport/styling/gui_fonts.h"
    },
    "generic_helper_contracts": {
      "scaler": "gui_fonts_compute_scale",
      "preset_lookup": "gui_fonts_match_preset",
      "path_resolver": "path_finder_resolve_with_hint"
    },
    "capacities": {
      "max_display_presets": 8,
      "base_dpi": 96
    }
  },
  "block_3_body": {
    "asset_paths": {
      "font_root": "game/assets/fonts/",
      "fonts": [
        {
          "id": "Cinzel-Bold",
          "name": "Cinzel Bold",
          "asset_path": "game/assets/fonts/Cinzel-Bold.ttf",
          "fallback_kind": "bitmap_ascii"
        },
        {
          "id": "CinzelDecorative-Bold",
          "name": "Cinzel Decorative Bold",
          "asset_path": "game/assets/fonts/CinzelDecorative-Bold.ttf",
          "fallback_kind": "bitmap_ascii"
        },
        {
          "id": "MedievalSharp",
          "name": "Medieval Sharp",
          "asset_path": "game/assets/fonts/MedievalSharp.ttf",
          "fallback_kind": "bitmap_ascii"
        }
      ]
    },
    "base_virtual_canvas": {
      "width": 640,
      "height": 360,
      "aspect_ratio": "16:9",
      "target_dpi": 96
    },
    "display_presets": [
      {
        "preset": "retro_canvas",
        "width": 640,
        "height": 360,
        "font_scale": 1.0,
        "pt_multiplier": 1.0
      },
      {
        "preset": "desktop_windowed",
        "width": 860,
        "height": 620,
        "font_scale": 1.25,
        "pt_multiplier": 1.2
      },
      {
        "preset": "hd_720p",
        "width": 1280,
        "height": 720,
        "font_scale": 2.0,
        "pt_multiplier": 1.8
      },
      {
        "preset": "full_hd_1080p",
        "width": 1920,
        "height": 1080,
        "font_scale": 3.0,
        "pt_multiplier": 2.5
      },
      {
        "preset": "ultra_hd_4k",
        "width": 3840,
        "height": 2160,
        "font_scale": 6.0,
        "pt_multiplier": 4.5
      }
    ]
  },
  "block_4_audit": {
    "tripwires": [
      {
        "id": "TRIPWIRE_SCALE_POSITIVE",
        "condition": "font_scale > 0.0 && pt_multiplier > 0.0",
        "action": "Clamp font scalers to minimum 1.0 if negative or zero"
      },
      {
        "id": "TRIPWIRE_BASE_CANVAS",
        "condition": "base_virtual_canvas.width == 640 && base_virtual_canvas.height == 360",
        "action": "Lock baseline virtual canvas to 640x360"
      }
    ],
    "metrics": {
      "display_presets_count": 5,
      "base_canvas_width": 640,
      "base_canvas_height": 360,
      "zero_heap_compliant": true
    }
  },
  "block_5_closing": {
    "navigation": {
      "parent_menu": "../manifest.json",
      "subdomain_manifest": "../manifest.json",
      "root_manifest": "../manifest.json",
      "menu_index": 2
    },
    "execution_hooks": {
      "on_load": "gui_fonts_load_scalers",
      "audit_hook": "gui_fonts_scaler_preflight"
    }
  }
}
