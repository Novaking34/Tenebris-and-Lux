{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "engine/config/viewport/assets.json",
    "id": "engine.config.viewport.assets",
    "layer": "Layer 0: Core Utilities / Viewport Presentation",
    "version": "0.1.1-dev",
    "interface_rev": "Rev 5",
    "date": "2026-11-08",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Generic engine asset registry binding slots to asset paths and procedural fallbacks.",
    "where_the_data_lives": {
      "topology": "Standalone Engine Viewport Configuration Architecture",
      "path": "engine/config/viewport/assets.json",
      "parent_manifest": "engine/config/manifest.json"
    },
    "what_it_enables": [
      "Decoupled asset slot abstraction with generic engine identifiers",
      "Direct asset path fast-lookup with O(1) existence checks",
      "Procedural fallback floor guaranteed when external files are omitted",
      "Consistent bounding dimensions for entities (32x32) and isometric tiles (48x24)"
    ],
    "invariants": [
      "Zero dynamic heap allocations in asset lookup (ALLOC_ZERO_HEAP)",
      "Asset paths are strictly optional; missing paths fall back to procedural synthesis",
      "Procedural fallback floor covenant: engine is 100% playable without external assets",
      "Numerical slot identifiers must align with gui_asset_id_t enum"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "viewport_assets": "viewport/styling/gui_assets.h",
      "gui_types": "viewport/raster/gui_types.h"
    },
    "static_declarations": {
      "schema_id": "tenlux.engine.viewport.assets.v1",
      "target_struct": "gui_asset_registry_t",
      "header_binding": "include/viewport/styling/gui_assets.h"
    },
    "generic_helper_contracts": {
      "loader": "gui_assets_load_registry",
      "path_resolver": "path_finder_resolve_with_hint"
    },
    "capacities": {
      "max_asset_slots": 64,
      "default_filtering": "nearest_neighbor"
    }
  },
