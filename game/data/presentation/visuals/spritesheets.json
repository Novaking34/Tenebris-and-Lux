    "where_the_data_lives": {
      "topology": "Presentation Visuals Architecture",
      "path": "game/data/presentation/visuals/spritesheets.json",
      "parent_manifest": "game/data/presentation/visuals/manifest.json"
    },
    "what_it_enables": [
      "4-Directional sprite sheet slicing (South=0, West=1, East=2, North=3)",
      "Uniform 32x32 pixel cell grids with custom pivot anchor coordinates",
      "Procedural sprite generator binding for characters, companions, and adversaries",
      "Seamless integration with animation clips and directional facing logic"
    ],
    "invariants": [
      "Zero dynamic heap allocations during sprite atlas lookup (ALLOC_ZERO_HEAP)",
      "Standard cell size: strictly 32x32 pixels",
      "Direction indices must strictly map to [0=South, 1=West, 2=East, 3=North]",
      "All sprite sheet paths must specify valid procedural fallback generators"
    ]
  },
