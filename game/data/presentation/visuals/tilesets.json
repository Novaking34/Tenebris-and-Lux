    "what_it_enables": [
      "Tactical grid tile visual definitions for Sacyra Plains, Forests, and Nocturnal Dream Chamber",
      "Physical terrain properties: movement friction multipliers, cover percentages, line-of-sight obstruction",
      "Procedural hex color fallback if external PNG tileset sheets are absent",
      "Decoupled rendering: presentation grid projects simulation grid terrain coordinates"
    ],
    "invariants": [
      "Zero dynamic heap allocations during tile coordinate resolution (ALLOC_ZERO_HEAP)",
      "Standard tile size: strictly 32 pixels baseline",
      "Friction multiplier must be non-negative",
      "Cover percentage bounded within [0, 100]"
    ]
  },
