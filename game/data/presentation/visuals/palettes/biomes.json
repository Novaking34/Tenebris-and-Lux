    "role": "2D tactical grid terrain tile colors and environmental palette definitions for High Fantasy Hope.",
    "where_the_data_lives": {
      "topology": "Presentation Palettes Architecture",
      "path": "game/data/presentation/visuals/palettes/biomes.json",
      "parent_manifest": "game/data/presentation/visuals/palettes/manifest.json"
    },
    "what_it_enables": [
      "Provincial biome environmental color palettes (Sacyra, Libira, Dreamscape, Academy Frost)",
      "Vibrant high fantasy environments: lush royal grasslands, sun-warmed dunes, crystalline glacial spires",
      "Celestial Dreamscape styling: shimmering starlight and radiant chimes instead of sterile darkness",
      "24-bit RGB hardware color lookup tables without runtime heap allocation"
    ],
    "invariants": [
      "Zero dynamic heap allocations in palette lookup (ALLOC_ZERO_HEAP)",
      "All palette entries strictly conform to 24-bit 0xRRGGBB hex notation",
      "The world is real to the touch, dark in places, but fundamentally illuminated by hope",
      "Visual presentation color mapping never alters terrain simulation geometry"
    ]
  },
