{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "game/data/presentation/visuals/palettes/themes.json",
    "id": "data.presentation.visuals.palettes.themes",
    "layer": "Layer 2: Presentation & Viewports",
    "version": "0.1.0",
    "interface_rev": "Rev 4",
    "date": "2026-11-07",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Master UI color themes and window chrome color specifications.",
    "where_the_data_lives": {
      "topology": "Presentation Palettes Architecture",
      "path": "game/data/presentation/visuals/palettes/themes.json",
      "parent_manifest": "game/data/presentation/visuals/palettes/manifest.json"
    },
    "what_it_enables": [
      "Canonical High Fantasy Realism theme blending grounded tactile weight with radiant hope",
      "Window chrome border styles, noble panel backdrops, and luminous button hover states",
      "Dynamic theme switching across dawn radiance, high fantasy hope, and twilight shadow",
      "High-contrast color profiles ensuring text legibility while evoking a warm, living world"
    ],
    "invariants": [
      "Zero dynamic heap allocations in theme lookup (ALLOC_ZERO_HEAP)",
      "The game is grounded and real to the touch, feeling dark in places but fundamentally a story of hope",
      "Active theme must match an identifier within the registered themes array",
      "All color codes must strictly conform to 24-bit 0xRRGGBB hex notation"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "viewport_palette": "viewport/gui_palette.h",
      "gui_types": "viewport/gui_types.h"
    },
    "static_declarations": {
      "schema_id": "tenlux.data.visuals.palettes.themes.v1",
      "target_struct": "gui_theme_catalog_t",
      "header_binding": "include/viewport/gui_palette.h"
    },
    "generic_helper_contracts": {
      "loader": "gui_palette_load_themes",
      "theme_selector": "gui_palette_set_active_theme"
    },
    "capacities": {
      "max_themes": 8,
      "color_depth_bits": 24
    }
  },
