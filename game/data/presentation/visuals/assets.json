    "role": "Asset abstraction registry binding procedural graphics and artist sprites.",
    "where_the_data_lives": {
      "topology": "Presentation Visuals Architecture",
      "path": "game/data/presentation/visuals/assets.json",
      "parent_manifest": "game/data/presentation/visuals/manifest.json"
    },
    "what_it_enables": [
      "Decoupled asset abstraction: procedural vector generators with artist PNG overrides",
      "Entity visual anchors and bounding dimensions (32x32 character, 48x24 iso tile)",
      "Procedural crest generators for Elijah, Katrina, Casatti, and Abyssal adversaries",
      "Relic icon bindings for the Shield of Lux and Sword of Tenebris"
    ],
    "invariants": [
      "Zero dynamic heap allocations in asset lookup (ALLOC_ZERO_HEAP)",
      "Asset keys and numerical identifiers must be globally unique",
      "Every asset must specify a valid procedural fallback generator",
      "Visual rendering never mutates simulation entity state"
    ]
  },
