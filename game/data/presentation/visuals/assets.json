      "target_struct": "gui_asset_registry_t",
      "header_binding": "include/viewport/gui_assets.h"
    },
    "generic_helper_contracts": {
      "loader": "gui_assets_load_registry",
      "resolver": "gui_assets_resolve_render_proc"
    },
    "capacities": {
      "max_assets": 64,
      "default_texture_filtering": "nearest_neighbor"
    }
  },
