  "block_3_body": {
    "profile": {
      "id": "default",
      "display_name": "Standard Continental Lexical Profile",
      "description": "Standard buffer capacities, stance tokens, and canonical action verb dictionaries.",
      "max_path_length": 512,
      "max_name_length": 64,
      "max_command_length": 128,
      "max_line_length": 80,
