{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "game/data/system/runtime/time/manifest.json",
    "id": "data.system.time.manifest",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.0",
    "interface_rev": "Rev 3",
    "date": "2026-11-05",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "Time Subsystem Manifest indexing frame pacing, lag resilience, and calendar profiles.",
    "where_the_data_lives": {
      "assembly_directory": "game/data/system/runtime/time/",
      "default_profile": "default.json",
      "high_refresh_profile": "high_refresh.json",
      "low_spec_profile": "low_spec_30fps.json",
      "pacing_policy": "pacing_policy.json",
      "calendar_spec": "calendar.json"
    },
    "what_it_enables": [
      "Multi-tier frame pacing: 30 FPS (Low-Spec), 60 FPS (Standard), and 120 FPS (High-Refresh)",
      "Lag spike defense and delta clamping preventing the simulation 'spiral of death'",
      "Fixed simulation timestep decoupling physics and combat turns from render framerates",
      "Diegetic calendar tracking diurnal day/night cycles and nocturnal Dreamscape portals"
    ],
    "invariants": [
      "Zero dynamic heap allocation across all timing systems (ALLOC_ZERO_HEAP)",
      "Strict conformance to OmniCode 5-Block Architecture",
      "Monotonic clock source strictly anchored to POSIX.1b CLOCK_MONOTONIC"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "clock_source": "CLOCK_MONOTONIC",
      "fs_buffer_limit": "FS_BUFFER_LARGE_BYTES (32768)"
    },
    "static_declarations": {
      "subsystem": "core.util.time",
      "schema_id": "tenlux.data.time_menu.v1",
      "total_catalogs": 5,
      "framerate_profiles_count": 3
    },
    "generic_helper_contracts": {
      "time_loader": "time_load_config_from_file",
      "path_resolver": "fs_resolve_data_path"
    }
  },
  "block_3_body": {
    "active_profile": "default",
    "profiles": [
      {
        "id": "default",
        "display_name": "Standard 60 FPS Engine Timing Profile",
        "file": "default.json",
        "description": "60 FPS (16.67 ms) with 50 us turn budget and 60 Hz tick rate."
      },
      {
        "id": "high_refresh",
        "display_name": "High-Refresh 120 FPS Gaming Profile",
        "file": "high_refresh.json",
        "description": "120 FPS (8.33 ms) with 25 us turn budget and 120 Hz tick rate."
      },
      {
        "id": "low_spec_30fps",
        "display_name": "Low-Spec 30 FPS Battery Saver Profile",
        "file": "low_spec_30fps.json",
        "description": "30 FPS (33.33 ms) with 100 us turn budget for low-end or battery hardware."
      },
      {
        "id": "pacing_policy",
        "display_name": "Frame Pacing & Lag Compensation Policy",
        "file": "pacing_policy.json",
        "description": "Max delta clamp (100 ms), spiral-of-death safety, and render interpolation."
      },
      {
        "id": "calendar",
        "display_name": "Diegetic Monotonic Calendar & Diurnal Clock",
        "file": "calendar.json",
        "description": "24-hour diurnal phases, nocturnal Dreamscape window, and Festival countdown."
      }
    ]
  },
  "block_4_audit": {
    "tripwires": [
      {
        "id": "TRIPWIRE_FPS_POSITIVE",
        "rule": "target_fps > 0 across all timing profiles",
        "status": "VERIFIED_PASS"
      },
      {
        "id": "TRIPWIRE_CATALOGS_COUNT",
        "rule": "registered catalogs count == 5",
        "status": "VERIFIED_PASS"
      }
    ],
    "metrics": {
      "total_catalogs": 5,
      "framerate_profiles": 3,
      "zero_heap_compliant": true
    },
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "navigation": {
      "parent_menu": "../manifest.json",
      "root_manifest": "../../../manifest.json",
      "current_directory": "system/runtime/time"
    },
    "execution_hooks": {
      "on_load": "time_load_config_from_file",
      "audit_hook": "time_utils_preflight"
    }
  }
}
