    "role": "Default 60 FPS timing and latency budget configuration profile.",
    "where_the_data_lives": {
      "topology": "System Runtime Timing",
      "path": "game/data/system/runtime/time/default.json"
    },
    "what_it_enables": [
      "Standard 60 Hz frame pacing with 16.67ms frame budget",
      "Deterministic monotonic clock pacing without wall-clock drift",
      "Strict 50 us simulation turn latency budget guaranteeing zero softlocks",
      "Sub-millisecond diagnostic pre-flight budget (1000 us)"
    ],
    "invariants": [
      "Zero dynamic heap allocations during time profile loading (ALLOC_ZERO_HEAP)",
      "Target FPS must be strictly positive (target_fps > 0)",
      "Frame budget in ms must equal 1000.0 / target_fps within sub-microsecond precision",
      "Monotonic timing source strictly anchored to POSIX.1b CLOCK_MONOTONIC"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "time_utils": "core/time_utils.h",
      "clock_source": "CLOCK_MONOTONIC"
    },
    "static_declarations": {
      "schema_id": "tenlux.data.time_profile.v1",
      "target_struct": "time_config_t",
      "header_binding": "include/core/time_utils.h"
    },
    "generic_helper_contracts": {
      "loader": "time_load_config_from_file",
      "now": "time_monotonic_now_ns",
      "sleep_ms": "time_sleep_ms"
    }
  },
  "block_3_body": {
    "profile": {
      "id": "default",
      "display_name": "Standard 60 FPS Engine Timing Profile",
      "description": "Standard 60 Hz frame pacing with 50 us simulation turn latency budget.",
      "target_fps": 60,
      "frame_budget_ms": 16.666667,
      "turn_latency_budget_us": 50.0,
      "preflight_latency_budget_us": 1000.0,
      "disk_query_budget_us": 500.0,
      "token_extraction_budget_us": 50.0,
      "tick_rate_hz": 60
    }
  },
  "block_4_audit": {
    "tripwires": [
      {
        "id": "TRIPWIRE_FPS_BOUNDS",
        "condition": "target_fps == 60",
        "action": "Fatal halt if default target FPS deviates from 60 Hz"
      },
      {
        "id": "TRIPWIRE_FRAME_BUDGET",
        "condition": "frame_budget_ms > 16.0 && frame_budget_ms < 17.0",
        "action": "Fatal halt if frame budget is mathematically inconsistent"
      }
    ],
    "metrics": {
      "expected_ms_per_frame": 16.666667,
      "max_simulation_turn_cost_pct": 0.3,
      "monotonic_clock_source": "CLOCK_MONOTONIC",
      "zero_heap_compliant": true
    }
  },
  "block_5_closing": {
    "navigation": {
      "parent_menu": "manifest.json",
      "subdomain_manifest": "../manifest.json",
      "root_manifest": "../../../manifest.json",
      "menu_index": 1
    },
    "execution_hooks": {
      "on_load": "time_load_config_from_file",
      "audit_hook": "time_utils_preflight"
    }
  }
}
