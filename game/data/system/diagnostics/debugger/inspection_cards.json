{
  "block_1_metadata": {
    "project": "Tenebris and Lux",
    "file": "game/data/system/diagnostics/debugger/inspection_cards.json",
    "id": "data.system.diagnostics.debugger.inspection_cards",
    "layer": "Layer 0: Core Utilities",
    "version": "0.1.0",
    "interface_rev": "Rev 1",
    "date": "2026-11-05",
    "author": "CreativeWorkzStudio LLC / ProfessorSeanEX",
    "repository": "https://github.com/Novaking34/tenebris-lux",
    "role": "ASCII inspection card layout templates for deterministic terminal and log state readouts.",
    "where_the_data_lives": {
      "path": "game/data/system/diagnostics/debugger/inspection_cards.json",
      "header_binding": "engine/include/debug/debug.h"
    },
    "what_it_enables": [
      "Standardized fixed-width visual cards for interactive terminal CLI dumps",
      "Instant situational awareness during combat and state debugging",
      "Consistent formatting between interactive REPL and post-mortem flight logs"
    ],
    "invariants": [
      "Zero dynamic heap allocations during card formatting or terminal rendering",
      "All card templates strictly bounded to 60-80 columns for standard terminals",
      "Universal 5-Block Lifecycle Protocol enforced across all definitions"
    ]
  },
  "block_2_opening": {
    "pre_conditions": {
      "debug_subsystem_initialized": true,
      "ansi_formatting_ready": true
    },
    "static_declarations": {
      "schema_id": "tenlux.data.inspection_cards.v1",
      "registered_card_count": 5,
      "standard_width_columns": 60
    },
    "generic_helper_contracts": {
      "card_formatter": "debug_format_inspection_card",
      "card_printer": "debug_dump_state_to_console"
    }
  },
  "block_3_body": {
    "cards": [
      {
        "card_id": "CARD_HERO_VITALS",
        "title": "Hero Vitals & Stance Status Card",
        "target_entity": "player_state_t",
        "columns": 60,
        "repl_command": "inspect hero",
        "description": "Visual summary of protagonist vitals, exploration stats, combat stats, active stance, and twin relics.",
        "layout_template": [
          "============================================================",
          "              HERO VITALS & STANCE READOUT                  ",
          "============================================================",
          "Protagonist:   {hero_name} ({hero_title})                   ",
          "Bound Relic:   {bound_relic}       Class: {hero_class}      ",
          "Vitals:        HP: {hp}/{max_hp}  MP: {mp}/{max_mp}  TP: {tp}",
          "Active Stance: {current_stance}                             ",
          "Relic Resonance:                                            ",
          "  [LUX] Shield: {lux_resonance}/100  (Warding Power)        ",
          "  [TEN] Sword:  {tenebris_resonance}/100  (Edge Sharpness)  ",
          "Combat Stats:  ATK:{atk} DEF:{def} MAT:{mat} MDF:{mdf}      ",
          "               ACC:{acc} EVA:{eva} AGI:{agi} LUK:{luk}      ",
          "Exploration:   STR:{str} DEX:{dex} VIT:{vit} INT:{int}      ",
          "               WIS:{wis} CHA:{cha} PER:{per} REP:{rep}      ",
          "Location:      {realm_name} -> {map_name} ({grid_x},{grid_y})",
          "============================================================"
        ]
      },
      {
        "card_id": "CARD_STATERA_LEDGER",
        "title": "Statera Conscience & Morality Ledger Card",
        "target_entity": "statera_ledger_t",
        "columns": 60,
        "repl_command": "inspect statera",
        "description": "Detailed readout of moral sway continuum, cumulative virtue/malice, and active campaign ending trajectory.",
        "layout_template": [
          "============================================================",
          "              STATERA CONSCIENCE LEDGER                     ",
          "============================================================",
          "Moral Sway:    {moral_sway_int} [{sway_bar_visualization}]  ",
          "Moral Tier:    Tier {tier_number}: {tier_name}              ",
          "Virtue Ledger: +{virtue_acc} (Selfless acts, defense, aid)  ",
          "Malice Ledger: -{malice_acc} (Ruthless strikes, severance)  ",
          "Statera Status: {statera_status_badge}                      ",
          "Ending Fork:   {predicted_campaign_ending}                  ",
          "Dream Compass: Calibrated: {compass_calibrated} ({drift}°)  ",
          "============================================================"
        ]
      },
      {
        "card_id": "CARD_COMBAT_ENGAGEMENT",
        "title": "Tactical Combat Engagement Card",
        "target_entity": "combat_engagement_t",
        "columns": 60,
        "repl_command": "inspect combat",
        "description": "Turn queue, active threat, directional facing, flank vigor, and zone of control.",
        "layout_template": [
          "============================================================",
          "              TACTICAL COMBAT ENGAGEMENT                    ",
          "============================================================",
          "Combat Turn:   Turn #{turn_number}   Action Gauge: {gauge}% ",
          "Active Threat: {target_name} ({target_hp}/{target_max_hp} HP)",
          "Target Flank:  Flank Vigor: {flank_vigor}/{max_flank} HP    ",
          "Facing Angle:  {facing_direction} (Modifier: {facing_mod})  ",
          "Zone of Control: Type: {zoc_type}  Trap: {is_zoc_trapped}   ",
          "Active Buffs:  Lux Barrio: {barrio_turns}t  Cuttatio: {cut}t",
          "Stamina/TP:    Available: {tp_available} TP (Cost: {tp_cost})",
          "============================================================"
        ]
      },
      {
        "card_id": "CARD_ENGINE_HEARTBEAT",
        "title": "Engine Heartbeat & Platform Vitals Card",
        "target_entity": "engine_diagnostics_t",
        "columns": 60,
        "repl_command": "inspect engine",
        "description": "Low-level engine diagnostic metrics: frame delta, clamped ticks, memory ring buffer, and viewport status.",
        "layout_template": [
          "============================================================",
          "              ENGINE PLATFORM HEARTBEAT                     ",
          "============================================================",
          "Monotonic Time: {monotonic_us} us ({fps_current} FPS)       ",
          "Frame Delta:   {frame_delta_ms} ms (Clamp Max: 100 ms)      ",
          "Lag Defenses:  Clamped Ticks: {clamp_count}  Spiral: Safe   ",
          "Memory Stratum: Zero-Heap: VERIFIED  Static Ring: {ring_occ}",
          "Snapshot Depth: {snapshot_count}/64 (FNV-1a: 0x{state_hash})",
          "Presentation:  Mode: {display_mode}  Viewport: 640x360 ({scale}x)",
          "Font Cache:    Cinzel/MedievalSharp Hits: {cache_hit_pct}%  ",
          "============================================================"
        ]
      },
      {
        "card_id": "CARD_TRIPWIRE_DIAGNOSTIC",
        "title": "Diagnostic Tripwire Forensic Card",
        "target_entity": "tripwire_report_t",
        "columns": 60,
        "repl_command": "inspect tripwire",
        "description": "Forensic tripwire failure diagnostic card detailing domain, error code, root cause, and recovery action.",
        "layout_template": [
          "============================================================",
          "             DIAGNOSTIC TRIPWIRE FORENSIC REPORT            ",
          "============================================================",
          "Tripwire ID:   [{error_domain}:{error_category}]            ",
          "Mnemonic Code: {error_mnemonic} (0x{error_hex_code})        ",
          "Severity Latch:{severity_badge} (Weight: {severity_weight}) ",
          "Source Anchor: {source_file}:{source_line} in {source_func} ",
          "Error Message: {error_message}                              ",
          "Root Cause:    {root_cause_explanation}                     ",
          "Remedy Action: {suggested_remedy}                           ",
          "Recovery Mode: {recovery_policy_action}                     ",
          "============================================================"
        ]
      }
    ]
  },
  "block_4_audit": {
    "audit_metrics": {
      "card_count": 5,
      "standard_columns": 60,
      "all_cards_zero_heap": true
    },
    "verification_tripwires": [
      { "name": "CARD_COUNT_VERIFIED", "rule": "count(cards) == 5", "status": "VERIFIED_PASS" },
      { "name": "COLUMN_BOUNDS", "rule": "every(card.columns <= 80)", "status": "VERIFIED_PASS" }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "repl_commands": [ "inspect hero", "inspect statera", "inspect combat", "inspect engine", "inspect tripwire" ]
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "sister_catalog": "snapshot_policy.json"
    }
  }
}
