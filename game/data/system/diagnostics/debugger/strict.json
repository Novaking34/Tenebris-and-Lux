  "block_3_body": {
    "profile": {
      "id": "strict",
      "display_name": "Strict Invariant & Assertion Trap Profile",
      "description": "Halts immediately on any state breach, stance violation, or warning/error telemetry.",
      "enabled": true,
      "break_on_error": true,
      "break_on_tripwire": true,
      "break_on_sway_breach": true,
      "break_on_resonance_breach": true,
      "break_on_hp_zero": true,
      "break_on_stance_change": true,
      "max_snapshots": 64,
      "snapshot_interval_turns": 1,
      "auto_dump_on_tripwire": true,
      "interactive_repl": true,
      "ansi_color": true,
      "trace_channels": "all",
      "domain_traps": {
        "engine_traps_active": true,
        "game_traps_active": true
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "snapshot_capacity": 64,
      "trap_guards_active": 6,
      "verified_zero_heap": true
    },
    "verification_tripwires": [
      { "name": "BREAK_ON_ERROR", "rule": "break_on_error == true", "status": "VERIFIED_PASS" },
      { "name": "BREAK_ON_STANCE", "rule": "break_on_stance_change == true", "status": "VERIFIED_PASS" },
      { "name": "ZERO_HEAP_STRICT", "rule": "Zero dynamic allocations during debug", "status": "VERIFIED_PASS" }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
