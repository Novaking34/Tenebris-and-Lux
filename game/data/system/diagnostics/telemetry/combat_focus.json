  "block_2_opening": {
    "pre_conditions": {
      "log_subsystem_initialized": true,
      "static_ring_buffer_allocated": true,
      "combat_engine_ready": true
    },
    "static_declarations": {
      "schema_id": "tenlux.data.log_setting.v1",
      "target_struct": "log_config_t",
      "header_binding": "engine/include/log/log.h",
      "supported_domains": [ "ENGINE", "GAME" ]
    },
    "generic_helper_contracts": {
      "config_loader": "log_load_config_from_file",
      "profiler_binding": "log_load_config_profile"
    }
  },
  "block_3_body": {
    "setting": {
      "id": "combat_focus",
      "display_name": "Combat & Relic Stance Telemetry Focus",
      "description": "Specialized profile routing combat stance shifts (Warding, Striking, Statera) and skill calculations (Lux Barrio, Cuttatio) to priority streams.",
      "log_dir": "logs",
      "base_filename": "tenebris_lux_combat.log",
      "max_file_size_bytes": 2097152,
      "max_rotated_files": 20,
      "min_severity": "DEBUG",
      "save_by_category": true,
      "echo_to_console": true,
      "use_colors": true,
      "telemetry": {
        "track_sequence_ids": true,
        "track_monotonic_us": true,
        "track_iso_timestamps": true,
        "track_moral_grades": true,
        "detailed_combat_calculations": true,
        "detailed_stance_transitions": true,
        "active_categories": [
          "EVENT",
          "CHARACTER",
          "LOG"
        ]
      },
      "severity_filter_mask": "0x7E",
      "min_severity_weight": 10,
      "domain_routing": {
        "engine_domain_enabled": false,
        "game_domain_enabled": true,
        "isolate_domain_files": true
      }
    }
  },
  "block_4_audit": {
    "audit_metrics": {
      "rotation_threshold_kb": 2048,
      "retention_policy": "Retain 20 timestamped rotated archives",
      "stance_machine_auditing": true,
      "relic_resonance_tracking": true,
      "statera_tracking_active": true
    },
    "verification_tripwires": [
      { "name": "COMBAT_CATEGORIES", "rule": "CHARACTER and EVENT active", "status": "VERIFIED_PASS" },
      { "name": "DEBUG_FLOOR", "rule": "min_severity <= DEBUG", "status": "VERIFIED_PASS" },
      { "name": "ZERO_HEAP_COMBAT", "rule": "Zero dynamic allocations during write", "status": "VERIFIED_PASS" }
    ],
    "self_audit_target": "./build/tenebris-lux --audit"
  },
  "block_5_closing": {
    "execution_handshake": {
      "cli_flags": [ "--cli", "--debug" ]
    },
    "navigation": {
      "parent_menu": "manifest.json",
      "menu_index": 6
    }
  }
