      "fs_buffer_limit": "FS_BUFFER_LARGE_BYTES (32768)"
    },
    "static_declarations": {
      "subsystem": "sim.world.terrains",
      "schema_id": "tenlux.data.world.terrains.v1",
      "max_terrain_types": 16
    },
    "generic_helper_contracts": {
      "path_resolver": "fs_resolve_data_path"
    }
  },
  "block_3_body": {
    "catalogs": [
      {
        "id": "default",
        "file": "default.json",
        "description": "Tactical terrain properties, movement friction, cover, and relic resonance",
